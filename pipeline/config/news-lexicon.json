 "attach": {
  "keywords": [
   {
    "pattern": "\\b(sign(s|ed|ing)?|into law)\\b",
    "classes": [
     "executive-signature",
     "became-law"
    ]
   },
   {
    "pattern": "\\bveto(es|ed)?\\b",
    "classes": [
     "executive-veto"
    ]
   },
   {
    "pattern": "\\boverrid(e|es|den)\\b",
    "classes": [
     "veto-override-passage"
    ]
   },
   {
    "pattern": "\\b(pass(es|ed)?|approv(es|ed))\\b",
    "classes": [
     "passage",
     "committee-passage",
     "concurrence",
     "veto-override-passage"
    ]
   },
   {
    "pattern": "\\bhearings?\\b|\\btestif(y|ies|ied)\\b",
    "classes": [
     "hearing-scheduled",
     "hearing-held"
    ]
   },
   {
    "pattern": "\\bintroduc(e|es|ed)\\b",
    "classes": [
     "introduction"
    ]
   },
   {
    "pattern": "\\bexecutive order\\b",
    "classes": [
     "executive-order"
    ]
   },
   {
    "pattern": "\\b(final rule|proposed rule|rulemaking)\\b",
    "classes": [
     "agency-rule-final",
     "agency-rule-proposed"
    ]
   }
  ],
  "not_a_report": {
   "_note": "one whole pattern",
   "pattern": "\\b(fail|fails|failed|reject\\w*|defeat\\w*|block\\w*|urg\\w*|calls? on|called on|oppos\\w*|not|won't|would|should|must|kills|killed|killing|shelves|shelved|stalls|stalled|die|dies|died|dead|tabl\\w*|sustain\\w*|amendments?|resolutions?|budget|appropriations?)\\b|\\b(passed|approved|signed|vetoed) by\\b|-(passed|approved|signed|vetoed)\\b"
  },
  "chamber_next_ok": {
