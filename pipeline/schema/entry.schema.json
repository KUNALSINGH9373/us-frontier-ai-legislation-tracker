{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracker.local/schema/entry.schema.json",
  "title": "Tracker entry (v2)",
  "description": "One law, bill, executive action, lawsuit or export control. Everything the UI shows for an entry comes from this object. Dates and status are structured fields, not prose, so the agents can update them without rewriting text.",
  "type": "object",
  "required": [
    "id",
    "key",
    "section",
    "type",
    "level",
    "jurisdiction",
    "state",
    "status",
    "title",
    "short_name",
    "sponsor_text",
    "mechanism",
    "events",
    "sources",
    "confidence",
    "origin",
    "verification",
    "last_checked",
    "last_changed"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy number the UI and the old site already use. Never reused."
    },
    "key": {
      "$ref": "common.schema.json#/$defs/key"
    },
    "section": {
      "$ref": "common.schema.json#/$defs/section"
    },
    "type": {
      "$ref": "common.schema.json#/$defs/type"
    },
    "level": {
      "$ref": "common.schema.json#/$defs/level"
    },
    "jurisdiction": {
      "$ref": "common.schema.json#/$defs/jurisdiction"
    },
    "state": {
      "$ref": "common.schema.json#/$defs/stateCode"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "description": "Full title with citation, as the tracker writes it."
    },
    "short_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "description": "How to find this entry in each official API. This is what lets the Grabber match an API record to this entry.",
      "properties": {
        "bill_number": {
          "type": "string",
          "description": "e.g. S.B. 53, H.R. 9925, EO 14365"
        },
        "session": {
          "type": "string",
          "description": "e.g. 2025-2026, 119th Congress"
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "congress_gov": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^\\d+/[a-z]+/\\d+$"
              },
              "description": "Every Congress.gov bill this entry covers, e.g. [\"119/hr/9925\"]. Some entries cover a House and a Senate bill."
            },
            "legiscan_bill_id": {
              "type": "integer"
            }, "legiscan": { "type": "array", "minItems": 1, "items": { "type": "integer" }, "description": "Every LegiScan bill_id this entry covers (companions too). The official citation is still the legislature page." },
            "openstates_id": {
              "type": "string"
            },
            "courtlistener_docket": {
              "type": "string"
            },
            "federal_register_doc": {
              "type": "string"
            }
          }
        }
      }
    },
    "sponsor_text": {
      "type": "string",
      "description": "Sponsors exactly as displayed."
    },
    "record_facts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Plain facts from the official record, written by code (Tier A). Optional; only facts the record states as a number.",
      "properties": {
        "cosponsors": {
          "type": "object",
          "required": ["count", "as_of", "source_url"],
          "additionalProperties": false,
          "description": "Current cosponsors on Congress.gov (bill.cosponsors.count; withdrawn cosponsors not counted). sponsor_text ends with the same total in fixed wording.",
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "as_of": { "$ref": "common.schema.json#/$defs/isoDate" },
            "source_url": { "$ref": "common.schema.json#/$defs/url" }
          }
        }
      }
    },
    "sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "party": {
            "type": "string"
          },
          "chamber": {
            "enum": [
              "house",
              "senate",
              "assembly",
              "other"
            ]
          },
          "state": {
            "type": "string"
          },
          "role": {
            "enum": [
              "primary",
              "cosponsor",
              "supporter",
              "opponent"
            ]
          }
        }
      }
    },
    "mechanism": {
      "type": "string",
      "minLength": 1,
      "description": "What it does. For automated entries this must be supported by evidence quotes."
    },
    "thresholds": {
      "type": [
        "string",
        "null"
      ],
      "description": "Who it covers (compute, revenue, scope)."
    },
    "penalties": {
      "type": [
        "string",
        "null"
      ]
    },
    "status_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "Status and dates as displayed prose. Kept for display; the structured events below are what the UI computes from."
    },
    "signed_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "events": {
      "type": "array",
      "description": "Every dated step, oldest first.",
      "items": {
        "type": "object",
        "required": [
          "date",
          "precision",
          "type",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "$ref": "common.schema.json#/$defs/isoDate"
          },
          "precision": {
            "enum": [
              "day",
              "month"
            ]
          },
          "type": {
            "$ref": "common.schema.json#/$defs/eventType"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "What happened, short."
          },
          "clause": {
            "type": "string",
            "description": "The verbatim sentence the event was read from."
          },
          "inferred_year": {
            "type": "boolean"
          },
          "scheduled": {
            "type": "boolean",
            "description": "True when the date is after the data cut-off."
          },
          "source_url": {
            "$ref": "common.schema.json#/$defs/url"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      }
    },
    "more_links": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/link"
      }
    },
    "source_label": {
      "type": "string",
      "description": "Short source line shown in the table."
    },
    "confidence": {
      "type": "object",
      "required": [
        "level",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/confidenceLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "$ref": "common.schema.json#/$defs/confidenceBasis"
        },
        "note": {
          "type": "string",
          "description": "What was and was not checked."
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "updated_after_verification": {
          "type": "boolean",
          "description": "The old marker U: added or changed in the checks after the main verification date."
        },
        "found_via": {
          "enum": [
            "dedicated_search",
            "ncsl",
            "api",
            "news",
            "author"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidence"
      }
    },
    "duties": {
      "type": "object",
      "description": "What the bill requires, one answer for each of the 13 duties (not_in_bill when the text is silent). Only bills that impose duties carry this. Each answer is checked word for word against the official text by pipeline/duties/check.mjs.",
      "required": ["framework", "transparency_report", "incident_reporting", "imminent_risk_reporting", "third_party_audit", "whistleblower", "registration", "shutdown", "compute_threshold", "revenue_threshold", "harm_threshold", "penalties", "effective_date"],
      "additionalProperties": false,
      "properties": {
        "framework": { "$ref": "common.schema.json#/$defs/duty", "description": "Safety / risk-management framework or protocol" },
        "transparency_report": { "$ref": "common.schema.json#/$defs/duty", "description": "Published transparency or model report" },
        "incident_reporting": { "$ref": "common.schema.json#/$defs/duty", "description": "Incident reporting, with its window" },
        "imminent_risk_reporting": { "$ref": "common.schema.json#/$defs/duty", "description": "Shorter window for imminent risk of death or serious injury" },
        "third_party_audit": { "$ref": "common.schema.json#/$defs/duty", "description": "Third-party audit, evaluation or verification" },
        "whistleblower": { "$ref": "common.schema.json#/$defs/duty", "description": "Whistleblower protection" },
        "registration": { "$ref": "common.schema.json#/$defs/duty", "description": "Registration, licensing or notification of the developer or model" },
        "shutdown": { "$ref": "common.schema.json#/$defs/duty", "description": "Shutdown / kill-switch capability" },
        "compute_threshold": { "$ref": "common.schema.json#/$defs/duty", "description": "Training-compute threshold that brings a model in scope" },
        "revenue_threshold": { "$ref": "common.schema.json#/$defs/duty", "description": "Revenue or spending threshold that brings a developer in scope" },
        "harm_threshold": { "$ref": "common.schema.json#/$defs/duty", "description": "Harm threshold (deaths, injuries, damages) that defines catastrophic risk" },
        "penalties": { "$ref": "common.schema.json#/$defs/duty", "description": "Penalties and who enforces them" },
        "effective_date": { "$ref": "common.schema.json#/$defs/duty", "description": "When the duties take effect" }
      }
    },
    "duties_basis": {
      "type": "object",
      "required": ["source_url", "sha256", "checked_at"],
      "additionalProperties": false,
      "description": "Which official text the duties were read from, so a changed text can be detected and the duties re-checked.",
      "properties": {
        "source_url": { "$ref": "common.schema.json#/$defs/url" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "chars": { "type": "integer", "minimum": 1 },
        "method": { "enum": ["agent", "session"], "description": "agent: written by the pipeline. session: written in a Claude session from the official text; every quote checked by code. Kept apart from verification.method so the rest of the entry keeps its own checks." },
        "checked_at": { "$ref": "common.schema.json#/$defs/isoDateTime" }
      }
    },
    "display_name": {
      "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[^\\n{}<>]+$",
      "description": "The name the entry page shows as its title, when the official short title cannot serve (only numbers, a chapter number, or an \"An Act relative to …\" title). Taken from the official text or the name the record uses; every number in it must appear in the title or short name (schema/integrity.mjs)."
    },
    "summary_line": {
      "type": "string", "minLength": 20, "maxLength": 240, "pattern": "^[^\\n{}<>]+$",
      "description": "One plain-English sentence under the page title: what the entry does. Every number in it must appear in the entry's own checked text (integrity)."
    },
    "thirty_seconds": {
      "type": "object", "required": ["a", "b", "c"], "additionalProperties": false,
      "description": "The three 'In 30 seconds' boxes. Their headings come from the layout: bill = Who / Must do / Or else; executive = Who it directs / What it orders / Binding on companies?; lawsuit = Who v. who / About / Where it is; watch item = What we watch / Why / Latest. Every number must appear in the entry's own checked text.",
      "properties": {
        "a": { "type": "string", "maxLength": 320, "pattern": "^[^\\n{}<>]*$" },
        "b": { "type": "string", "maxLength": 320, "pattern": "^[^\\n{}<>]*$" },
        "c": { "type": "string", "maxLength": 320, "pattern": "^[^\\n{}<>]*$" }
      }
    },
    "key_facts": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "description": "Key facts rows the record cannot give by code. Each value is short and taken from the official record; a row left out shows 'Not stated in our record'.",
      "properties": {
        "issued_by": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[^\\n{}<>]+$" },
        "lead_agencies": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[^\\n{}<>]+$" },
        "enforced_by": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[^\\n{}<>]+$" },
        "court": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[^\\n{}<>]+$" },
        "judge": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[^\\n{}<>]+$" },
        "plaintiff": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[^\\n{}<>]+$" },
        "defendants": { "type": "string", "minLength": 2, "maxLength": 200, "pattern": "^[^\\n{}<>]+$" },
        "lawyers": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[^\\n{}<>]+$" }
      }
    },
    "exec_checklist": {
      "type": "object", "additionalProperties": false,
      "required": ["binding", "voluntary_program", "pre_release_access", "agencies_build", "deadlines", "enforcement_priority", "targets_state_laws", "penalties"],
      "description": "An executive action's 'What it orders' checklist: the same eight questions on every executive action, each answered like a bill duty (a section and an exact quote unless not_in_bill). Only for executive and export-rule entries.",
      "properties": {
        "binding": { "$ref": "common.schema.json#/$defs/duty" },
        "voluntary_program": { "$ref": "common.schema.json#/$defs/duty" },
        "pre_release_access": { "$ref": "common.schema.json#/$defs/duty" },
        "agencies_build": { "$ref": "common.schema.json#/$defs/duty" },
        "deadlines": { "$ref": "common.schema.json#/$defs/duty" },
        "enforcement_priority": { "$ref": "common.schema.json#/$defs/duty" },
        "targets_state_laws": { "$ref": "common.schema.json#/$defs/duty" },
        "penalties": { "$ref": "common.schema.json#/$defs/duty" }
      }
    },
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "description": "A lawsuit's claims and how each fared, in the order the complaint pleads them. Every decided claim (won, lost, unclear) names the record it is read from. Only for litigation entries.",
      "items": {
        "type": "object", "required": ["label", "outcome"], "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[^\\n{}<>]+$" },
          "outcome": { "enum": ["won", "lost", "unclear", "pending"] },
          "note": { "type": "string", "minLength": 3, "maxLength": 240, "pattern": "^[^\\n{}<>]+$" },
          "source_url": { "$ref": "common.schema.json#/$defs/url" }
        },
        "if": { "properties": { "outcome": { "enum": ["won", "lost", "unclear"] } } },
        "then": { "required": ["source_url"] }
      }
    },
    "page_verification": {
      "type": "object", "required": ["method", "checked_at"], "additionalProperties": false,
      "description": "Who checked the page fields above (display_name, summary_line, thirty_seconds, key_facts, exec_checklist, claims) and when. Required whenever any of them is set (integrity): nothing on the page is published unreviewed.",
      "properties": {
        "method": { "enum": ["agent", "session", "author"] },
        "checked_at": { "$ref": "common.schema.json#/$defs/isoDateTime" },
        "reviewer": { "type": "string", "minLength": 2, "maxLength": 80 },
        "basis_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the entry's own checked text the page fields were written from (pagefields/layout.mjs entryText): when it changes, the pipeline writes them again." }
      }
    },
    "press": {
      "type": "array", "maxItems": 5,
      "description": "In the press (news/press.mjs): links to credible outlets' coverage of this entry, newest first. Only the outlet's own headline, its name, the date and the link; shown apart from the official record and labelled as press. Never changes any other field. Each was matched to this entry by its bill number or name and passed by the reviewer (about this entry, headline not misleading).",
      "items": {
        "type": "object", "required": ["headline", "outlet", "date", "url", "checked_at"], "additionalProperties": false,
        "properties": {
          "headline": { "type": "string", "minLength": 12, "maxLength": 300, "pattern": "^[^\\n{}<>]+$" },
          "outlet": { "enum": ["The New York Times", "The Washington Post", "CNN", "The Independent", "Politico"] },
          "date": { "$ref": "common.schema.json#/$defs/isoDate" },
          "url": { "$ref": "common.schema.json#/$defs/url" },
          "checked_at": { "$ref": "common.schema.json#/$defs/isoDateTime" }
        }
      }
    },
    "plain": {
      "type": "object",
      "required": ["box", "items"],
      "additionalProperties": false,
      "description": "A new-bills entry's plain-English page (agents/newbill-entry.mjs): the four-slot box and every item with the bill words it rests on. The site shows each item's text beside its quote. Written only by the new-bills writer, checked by code (every quote in the bill) and by the reviewer.",
      "properties": {
        "name_quote": { "type": "string", "description": "The bill words the headline name is copied from (empty when the name is descriptive)." },
        "box": {
          "type": "object",
          "required": ["applies_to", "requires_lead", "requires", "enforcement", "effective"],
          "additionalProperties": false,
          "properties": {
            "applies_to": { "type": "string" },
            "requires_lead": { "enum": ["Requires them to", "Directs"] },
            "requires": { "type": "string" },
            "enforcement": { "type": "string" },
            "effective": { "type": "string" }
          }
        },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coverage": { "$ref": "#/$defs/plainItems" },
            "definitions": { "$ref": "#/$defs/plainItems" },
            "exclusions": { "$ref": "#/$defs/plainItems" },
            "duties": { "$ref": "#/$defs/plainItems" },
            "penalties": { "$ref": "#/$defs/plainItems" },
            "effective": { "$ref": "#/$defs/plainItems" },
            "other_provisions": { "$ref": "#/$defs/plainItems" }
          }
        },
        "text_problems": { "type": "array", "items": { "type": "string" }, "description": "Damaged or inconsistent passages the writer reported (shown as a note, never guessed at)." },
        "facts_only": { "type": "boolean", "description": "true: the description did not pass its checks, so only the official facts are shown; retried on the next run." }
      }
    },
    "origin": {
      "$ref": "common.schema.json#/$defs/origin"
    },
    "verification": {
      "$ref": "common.schema.json#/$defs/verification"
    },
    "last_checked": {
      "$ref": "common.schema.json#/$defs/isoDate"
    },
    "last_changed": {
      "$ref": "common.schema.json#/$defs/isoDate"
    },
    "legacy": {
      "type": "object",
      "additionalProperties": true,
      "description": "Old-site references kept for continuity (permalink, section name, original table cells). Ignored by the pipeline."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "section": {
            "const": "J"
          }
        },
        "required": [
          "section"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "excluded"
          },
          "confidence": {
            "properties": {
              "level": {
                "type": "null"
              },
              "basis": {
                "const": "not_rated"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "enum": [
              "automated",
              "mixed"
            ]
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "required": [
          "evidence",
          "identifiers",
          "sources"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "verification": {
            "properties": {
              "method": {
                "const": "agent"
              },
              "run_id": {
                "type": "string"
              },
              "rounds": {
                "type": "integer"
              }
            },
            "required": [
              "run_id",
              "rounds"
            ]
          },
          "confidence": {
            "properties": {
              "basis": {
                "enum": [
                  "primary_record",
                  "corroborated",
                  "secondary",
                  "single_source"
                ]
              }
            }
          },
          "sources": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "const": "state"
          }
        },
        "required": [
          "level"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "const": "federal"
          }
        },
        "required": [
          "level"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "confidence": {
            "properties": {
              "basis": {
                "const": "primary_record"
              }
            },
            "required": [
              "basis"
            ]
          }
        },
        "required": [
          "confidence"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "properties": {
              "level": {
                "enum": [
                  "HIGH",
                  "MED-HIGH"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "confidence": {
            "properties": {
              "basis": {
                "const": "corroborated"
              }
            },
            "required": [
              "basis"
            ]
          }
        },
        "required": [
          "confidence"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "properties": {
              "level": {
                "enum": [
                  "MED-HIGH",
                  "MED"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "confidence": {
            "properties": {
              "basis": {
                "const": "secondary"
              }
            },
            "required": [
              "basis"
            ]
          }
        },
        "required": [
          "confidence"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "properties": {
              "level": {
                "enum": [
                  "MED",
                  "LOW"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "confidence": {
            "properties": {
              "basis": {
                "const": "single_source"
              }
            },
            "required": [
              "basis"
            ]
          }
        },
        "required": [
          "confidence"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "properties": {
              "level": {
                "enum": [
                  "LOW"
                ]
              }
            }
          }
        }
      }
    },
    {
