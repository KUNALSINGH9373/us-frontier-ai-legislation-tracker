{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracker.local/schema/news.schema.json",
  "title": "Updates feed (v2)",
  "description": "The dated news page. Items link to an entry through its stable key, not a number.",
  "type": "object",
  "required": ["title", "asof", "kinds", "items"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string" },
    "asof": { "type": "string", "description": "Display date the feed is current to." },
    "intro": { "type": "string" },
    "bottom": { "type": "string", "description": "The month in one paragraph." },
    "kinds": {
      "type": "object",
      "propertyNames": { "enum": ["federal", "state", "executive", "litigation", "industry"] },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "desc"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "desc": { "type": "string" }, "color": { "type": "string" }, "soft": { "type": "string" } }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "kind", "title", "body", "links", "origin", "verification"],
        "additionalProperties": false,
        "properties": {
          "date": { "$ref": "common.schema.json#/$defs/isoDate" },
          "kind": { "enum": ["federal", "state", "executive", "litigation", "industry"] },
          "title": { "type": "string", "minLength": 5 },
          "body": { "type": "string", "minLength": 20 },
          "links": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/link" } },
          "check": { "type": "string", "description": "What was and was not verified, e.g. a page that blocked automated access." },
          "tracker": { "oneOf": [{ "$ref": "common.schema.json#/$defs/key" }, { "type": "null" }], "description": "Key of the entry this item is about." },
          "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" } },
          "origin": { "$ref": "common.schema.json#/$defs/origin" },
          "verification": { "$ref": "common.schema.json#/$defs/verification" },
          "event_key": { "type": "string", "description": "news/events.mjs: the official event this item is rendered from (jurisdiction|entry|class|date)." },
          "class": { "type": "string", "description": "The event class (pipeline/news/CONTRACT.md)." },
          "status": { "enum": ["pending", "confirmed", "corrected", "withdrawn"] },
          "jurisdiction": { "type": "string" },
          "statements": { "type": "array", "items": { "type": "object", "required": ["t", "u"], "additionalProperties": false, "properties": { "t": { "type": "string" }, "u": { "$ref": "common.schema.json#/$defs/url" }, "publisher": { "type": ["string", "null"] } } } },
          "stage": { "enum": ["passed-both", "signed", "law"], "description": "Only what the item's own event class proves (pipeline/news/CONTRACT.md, review r6); omitted otherwise." },
          "comments_close": { "$ref": "common.schema.json#/$defs/isoDate" },
          "history": { "type": "array", "items": { "type": "object", "required": ["at", "change"], "properties": { "at": { "type": "string" }, "change": { "type": "string" }, "from": { "type": ["string", "null"] }, "to": { "type": ["string", "null"] } } } },
          "status_note": { "type": "string" }
        },
        "if": { "properties": { "origin": { "enum": ["automated", "mixed"] } }, "required": ["origin"] },
        "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
      }
    }
  }
}
