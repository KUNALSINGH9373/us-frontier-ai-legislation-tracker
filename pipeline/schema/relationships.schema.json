{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracker.local/schema/relationships.schema.json",
  "title": "Relationships (v2)",
  "description": "Who copied whom, who replaced whom, who challenged whom. Every link quotes the passage it comes from. Automated links may only be added when the source states the relationship; anything inferred must be marked unproven.",
  "type": "object",
  "required": ["types", "columns", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "types": {
      "type": "object",
      "propertyNames": { "enum": ["template", "succession", "fedstate", "executive", "litigation", "assurance", "actor"] },
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "color": { "type": "string" } }
      }
    },
    "columns": { "type": "array", "items": { "type": "string" }, "minItems": 2, "description": "Column titles of the network, left to right." },
    "nodes": {
      "type": "object",
      "description": "Every item that can appear in the network, by its short key (e.g. SB53, act-wiener).",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "column", "kind"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "column": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["entry", "actor"] },
          "entry_key": { "$ref": "common.schema.json#/$defs/key", "description": "Required for kind=entry: the entry this node represents." }
        },
        "if": { "properties": { "kind": { "const": "entry" } }, "required": ["kind"] },
        "then": { "required": ["entry_key"] }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type", "label", "quote", "origin"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "enum": ["template", "succession", "fedstate", "executive", "litigation", "assurance", "actor"] },
          "label": { "type": "string", "minLength": 3 },
          "quote": { "type": "string", "minLength": 8, "description": "Verbatim passage that states the relationship." },
          "source_url": { "$ref": "common.schema.json#/$defs/url" },
          "dashed": { "type": "boolean", "description": "True when the tracker itself calls the link unproven, asserted or negative." },
          "origin": { "$ref": "common.schema.json#/$defs/origin" },
          "src": { "type": "string", "description": "Where in the tracker the quote sits (legacy)." },
          "col": { "type": "string", "description": "Column of the tracker table it came from (legacy)." }
        },
        "if": { "properties": { "origin": { "enum": ["automated", "mixed"] } }, "required": ["origin"] },
        "then": { "required": ["source_url"] }
      }
    }
  }
}
