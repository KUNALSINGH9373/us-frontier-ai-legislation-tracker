{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracker.local/schema/site.schema.json",
  "title": "Site settings (v2)",
  "description": "Dates and labels the UI shows. Headline counts are NOT stored here: the build computes them from the entries, so they cannot drift from the data.",
  "type": "object",
  "required": ["verified_as_of", "updates_through", "section_names", "replay_milestones"],
  "additionalProperties": false,
  "properties": {
    "verified_as_of": { "$ref": "common.schema.json#/$defs/isoDate", "description": "The date the author's main verification ended." },
    "updates_through": { "$ref": "common.schema.json#/$defs/isoDate", "description": "The date of the latest supplementary or automated check. The UI treats this as 'today' for scheduled-date logic." },
    "week_from": { "$ref": "common.schema.json#/$defs/isoDate", "description": "Start of the 'this week' window." },
    "section_names": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/section" },
      "additionalProperties": { "type": "string" }
    },
    "replay_start": { "$ref": "common.schema.json#/$defs/isoDate", "description": "Where the home-page replay starts." },
    "section_groups": {
      "type": "array",
      "description": "How sections are grouped in the Explore sidebar and the table's Group filter (v1's grouping).",
      "items": {
        "type": "object",
        "required": ["key", "name", "sections"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string" },
          "sections": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/section" }, "minItems": 1 }
        }
      }
    },
    "federal_groups": {
      "type": "array",
      "description": "The federal sections shown on Home, in order, with a one-line note each.",
      "items": {
        "type": "object",
        "required": ["section", "name"],
        "additionalProperties": false,
        "properties": {
          "section": { "$ref": "common.schema.json#/$defs/section" },
          "name": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "replay_milestones": {
      "type": "array",
      "description": "The captioned moments in the home-page replay. They point at entries by key, replacing the hardcoded numbers.",
      "items": {
        "type": "object",
        "required": ["date", "entry_key", "caption"],
        "additionalProperties": false,
        "properties": {
          "date": { "$ref": "common.schema.json#/$defs/isoDate" },
          "entry_key": { "$ref": "common.schema.json#/$defs/key" },
          "caption": { "type": "string", "minLength": 8 }
        }
      }
    },
    "comparison_matrix": {
      "type": "object",
      "description": "The side-by-side comparison of the main laws (section K of the tracker).",
      "required": ["entry_keys", "rows"],
      "additionalProperties": false,
      "properties": {
        "entry_keys": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/key" }, "minItems": 2 },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "values"],
            "additionalProperties": false,
            "properties": {
              "dimension": { "type": "string" },
              "values": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Entry key to the value shown." },
              "note": { "type": "string", "description": "For a row that is not per-entry (v1's 'full spread' row): its text as one note." }
            }
          }
        }
      }
    }
  }
}
